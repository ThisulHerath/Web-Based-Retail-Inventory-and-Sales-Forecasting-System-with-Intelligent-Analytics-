# Server
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=10

# JWT Secrets (change these to unique random strings in production)
JWT_SECRET=your-jwt-secret-here
CUSTOMER_JWT_SECRET=your-customer-jwt-secret-here

# Supabase Configuration (get these from Supabase Dashboard → Settings → API)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
SUPABASE_ANON_KEY=your-anon-key-here
DATABASE_URL=postgresql://postgres:YOUR-PASSWORD@db.your-project-id.supabase.co:5432/postgres

# Email Configuration (for Welcome Emails)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_TLS_REJECT_UNAUTHORIZED=true
FROM_EMAIL=your_email@gmail.com
FROM_NAME="7 Super City Admin"
